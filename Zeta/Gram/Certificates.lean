/-- The certified sequence of good gram blocks: every gram point and contained zero carries a
certificate, the blocks tile consecutively (`seq`), the total span clears the Lehman bound
(`wide`), and the range sits above `168π` (`high`). -/
abbrev certifiedGramBlockSeq : CertifiedGramBlockSeq where
  blocks := [blk1, blk2, blk3, blk4, blk5, blk6, blk7, blk8, blk9, blk10, blk11, blk12, blk13,
    blk14, blk15, blk16, blk17, blk18, blk19, blk20, blk21, blk22, blk23, blk24, blk25,
    blk26, blk27]
  seq := by
    simp only [List.isChain_cons_cons, List.isChain_singleton, and_true]
  cert := by
    intro b hb
    fin_cases hb
    · exact blk1_cert
    · exact blk2_cert
    · exact blk3_cert
    · exact blk4_cert
    · exact blk5_cert
    · exact blk6_cert
    · exact blk7_cert
    · exact blk8_cert
    · exact blk9_cert
    · exact blk10_cert
    · exact blk11_cert
    · exact blk12_cert
    · exact blk13_cert
    · exact blk14_cert
    · exact blk15_cert
    · exact blk16_cert
    · exact blk17_cert
    · exact blk18_cert
    · exact blk19_cert
    · exact blk20_cert
    · exact blk21_cert
    · exact blk22_cert
    · exact blk23_cert
    · exact blk24_cert
    · exact blk25_cert
    · exact blk26_cert
    · exact blk27_cert
  non_empty := by simp
