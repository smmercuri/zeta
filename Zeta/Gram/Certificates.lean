/-- The certified sequence of good gram blocks: every gram point and contained zero carries a
certificate, the blocks tile consecutively (`seq`), the total span clears the Lehman bound
(`wide`), and the range sits above `168π` (`high`). -/
abbrev certifiedGramBlockSeq : CertifiedGramBlockSeq where
  blocks := [blk1, blk2, blk3, blk4, blk5, blk6, blk7, blk8, blk9, blk10, blk11, blk12, blk13,
    blk14, blk15, blk16, blk17, blk18, blk19, blk20, blk21, blk22, blk23, blk24, blk25]
  seq := by
    simp only [List.isChain_cons_cons, List.isChain_singleton, and_true]
  cert := by
    intro b hb
    fin_cases hb
    · exact blk1_cert
    · exact blk2_cert
    · exact blk3_cert
    · exact blk4_cert
    · exact blk5_cert
    · exact blk6_cert
    · exact blk7_cert
    · exact blk8_cert
    · exact blk9_cert
    · exact blk10_cert
    · exact blk11_cert
    · exact blk12_cert
    · exact blk13_cert
    · exact blk14_cert
    · exact blk15_cert
    · exact blk16_cert
    · exact blk17_cert
    · exact blk18_cert
    · exact blk19_cert
    · exact blk20_cert
    · exact blk21_cert
    · exact blk22_cert
    · exact blk23_cert
    · exact blk24_cert
    · exact blk25_cert
  non_empty := by simp
  wide := by
    change 5 + (0.128 : ℝ) * Real.log (gp26.snd / (2 * π)) < (gp26.fst - gp1.snd) / 2
    have hπ : (3.141592 : ℝ) < π := Real.pi_gt_d6
    have hX : ((gp26.snd : ℝ) / (2 * π)) ^ 1 < 2.718 ^ 12 := by
      rw [div_pow, div_lt_iff₀ (by positivity)]
      calc (gp26.snd : ℝ) ^ 1 < 2.718 ^ 12 * 6.283184 ^ 1 := by norm_num
        _ ≤ 2.718 ^ 12 * (2 * π) ^ 1 := by gcongr; linarith
    have he : (2.718 : ℝ) ^ 12 ≤ Real.exp 12 := by
      rw [show Real.exp 12 = Real.exp 1 ^ 12 by rw [← Real.exp_nat_mul]; norm_num]
      gcongr
      nlinarith [Real.exp_one_gt_d9]
    have hlog : (1 : ℝ) * Real.log (gp26.snd / (2 * π)) < 12 := by
      rw [show (1 : ℝ) * Real.log (gp26.snd / (2 * π))
          = Real.log (((gp26.snd : ℝ) / (2 * π)) ^ (1 : ℕ)) by rw [Real.log_pow]; norm_num]
      exact (Real.log_lt_iff_lt_exp (by positivity)).2 (hX.trans_le he)
    nlinarith [hlog]
  high := by
    change 168 * π < (1000449.28682 : ℝ)
    nlinarith [Real.pi_lt_d6]

